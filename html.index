<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>bundi ontita james - Personal Website</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 20px;
            background-color: #f4f4f9;
            color: #333;
        }

        /* Top and Bottom Navigation Menu */
        nav {
            background-color: #333;
            padding: 10px 0;
            text-align: center;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 0 15px;
            font-weight: bold;
            font-size: 18px;
        }

        nav a:hover {
            color: #4CAF50;
        }

        /* Marquee / Moving Name Styling */
        .marquee-container {
            margin: 15px 0;
            background-color: #e0e0e0;
            padding: 5px 0;
        }

        .marquee-text {
            font-size: 48px;
            font-weight: bold;
            color: #1a2a3a;
            white-space: nowrap;
        }

        /* Section Styling */
        .section {
            background-color: white;
            padding: 25px;
            margin: 20px 0;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        #hobbies-section {
            background-color: lightblue;
        }

        /* Profile Photo */
        .profile-photo {
            float: left;
            width: 150px;
            height: 150px;
            object-fit: cover;
            border-radius: 8px;
            margin-right: 20px;
            margin-bottom: 10px;
            border: 2px solid #ccc;
        }

        .clear {
            clear: both;
        }

        /* Table Styling for CV */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        table, th, td {
            border: 1px solid green;
        }

        th {
            background-color: lightblue;
            color: #000;
            padding: 12px;
            text-align: left;
        }

        td {
            padding: 10px;
        }

        /* Form Styling */
        form {
            max-width: 500px;
            margin-top: 15px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            color: brown;
            font-weight: bold;
        }

        .form-group input[type="text"],
        .form-group input[type="email"],
        .form-group textarea {
            width: 100%;
            padding: 8px;
            border: 1px solid #17a2b8;
            box-sizing: border-box;
        }

        .form-group textarea {
            height: 120px;
            resize: vertical;
        }

        .checkbox-group {
            margin-bottom: 15px;
            color: #333;
        }

        .btn-send {
            background-color: green;
            color: white;
            padding: 8px 16px;
            border: none;
            cursor: pointer;
            font-size: 16px;
            font-weight: bold;
        }

        .btn-send:hover {
            background-color: darkgreen;
        }

        /* Footer */
        footer {
            margin-top: 30px;
            text-align: center;
        }

        .copyright {
            color: green;
            font-weight: bold;
            margin-top: 15px;
            font-size: 14px;
        }
    </style>
</head>
<body>

    <!-- Top Menu -->
    <nav>
        <a href="#home">Home</a>
        <a href="#experience">Personal experience</a>
        <a href="#contacts">Contacts</a>
        <a href="#hobbies">Hobbies</a>
    </nav>

    <!-- Moving Name Heading -->
    <div class="marquee-container">
        <marquee class="marquee-text" behavior="scroll" direction="left">bundi ontita james</marquee>
    </div>

    <!-- (a) Home Page Section -->
    <div id="home" class="section">
        <h2>Home</h2>
        <img src="https://via.placeholder.com/150" alt="bundi ontita james" class="profile-photo">
        <p>
            Hello! My name is <strong>bundi ontita james</strong>. I am an undergraduate student pursuing a Bachelor's degree in Information Technology at Kisii University. I have a strong passion for web development, software engineering, and data science.
        </p>
        <p>
            My background stems from a deep curiosity about how computers and modern networks connect people worldwide. Throughout my academic journey, I have built foundation skills in HTML, CSS, JavaScript, and database systems.
        </p>
        <p>
            After completing my course, I hope to work as a Full-Stack Software Engineer and cloud specialist, designing innovative digital solutions that tackle real-world challenges across Africa and beyond.
        </p>
        <div class="clear"></div>
        <hr>
    </div>

    <!-- (b) Personal Experience Section -->
    <div id="experience" class="section">
        <h2>Personal Experience</h2>
        <table>
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Institutions attended</th>
                    <th>Awards given</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>2024 - Present</td>
                    <td>Kisii University</td>
                    <td>Certificate of Participation in Tech Hackathon</td>
                </tr>
                <tr>
                    <td>2019 - 2023</td>
                    <td>Secondary School Education</td>
                    <td>Kenya Certificate of Secondary Education (KCSE)</td>
                </tr>
                <tr>
                    <td>2011 - 2018</td>
                    <td>Primary School Education</td>
                    <td>Kenya Certificate of Primary Education (KCPE)</td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- (c) Contacts Section -->
    <div id="contacts" class="section">
        <h2>Contacts</h2>
        <p><strong>Phone:</strong> +254 700 000 000</p>
        <p><strong>Location:</strong> Kisii, Kenya</p>
        <p><a href="mailto:jamesontita@gmail.com" style="color: blue; text-decoration: underline; font-weight: bold;">Email me</a></p>
        
        <hr>

        <h3>Send a Message</h3>
        <form action="#" method="post">
            <div class="form-group">
                <label for="fullname">Enter your Name:</label>
                <input type="text" id="fullname" name="fullname">
            </div>

            <div class="form-group">
                <label for="email">E-mail address*:</label>
                <input type="email" id="email" name="email" required>
            </div>

            <div class="form-group">
                <label for="subject">Message Subject:</label>
                <input type="text" id="subject" name="subject">
            </div>

            <div class="form-group">
                <label for="message">Enter your Message*:</label>
                <textarea id="message" name="message" required></textarea>
            </div>

            <div class="checkbox-group">
                <input type="checkbox" id="copy" name="copy">
                <label for="copy" style="display:inline; color: inherit; font-weight: normal;">E-mail a copy of this message to your own address.</label>
            </div>

            <button type="submit" class="btn-send">Send</button>
        </form>
    </div>

    <!-- (e) Hobbies Section -->
    <div id="hobbies" class="section" id-mark="hobbies-section" style="background-color: lightblue;">
        <h2>Hobbies</h2>
        
        <h3>Ordered List of Hobbies</h3>
        <ol type="I">
            <li>Programming & Open-Source Projects</li>
            <li>Reading Technical Documentation & Tech Blogs</li>
            <li>Playing Chess & Solving Tactical Puzzles</li>
        </ol>

        <h3>Unordered List of Hobbies</h3>
        <ul>
            <li>Listening to Afrobeats and Music Composition</li>
            <li>Playing Mobile & Console Strategy Games</li>
            <li>Exploring Outdoor Nature Trails</li>
        </ul>
    </div>

    <!-- Bottom Menu -->
    <footer>
        <nav>
            <a href="#home">Home</a>
            <a href="#experience">Personal experience</a>
            <a href="#contacts">Contacts</a>
            <a href="#hobbies">Hobbies</a>
        </nav>
        
        <p class="copyright">&copy; 2026 bundi ontita james. All rights reserved.</p>
    </footer>

</body>
</html>